{
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "superpowers@superpowers-marketplace": true,
    "claude-mem@thedotmack": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"Standing instruction for this project (user, 2026-07-30): at the start of every task-oriented session, invoke the task-observer skill and the superpowers:using-superpowers skill before other work.\"}}'",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Injecting skill-activation reminder..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\".venv/Scripts/python.exe\" .claude/hooks/frozen_results_guard.py",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "Checking frozen-results guard..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\".venv/Scripts/python.exe\" .claude/hooks/run_offline_tests.py",
            "shell": "bash",
            "timeout": 300,
            "statusMessage": "Running offline contract tests..."
          }
        ]
      }
    ]
  }
}
