# Data (raw is re-downloadable; processed is regenerable)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# Exception: walk-forward baseline predictions are load-bearing for the
# v1.0-results freeze (SARIMAX is not bit-reproducible across BLAS builds)
!data/processed/baselines/

# Models & experiment artifacts
models/*
!models/.gitkeep
mlruns/

# Python
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Environments & editors
.env
.venv/
.vscode/
.DS_Store

# Graphify knowledge-graph output (regenerate with: graphify . --code-only)
graphify-out/

# Per-run stdout from long walk-forward jobs. Local diagnostic trail only —
# what a run concluded belongs in logs/decisions.md, which IS committed.
logs/runs/

# Claude Code: personal/session-local state (shared config in .claude/ is committed)
.claude/settings.local.json
.claude/worktrees/
