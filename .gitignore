# Data (raw is re-downloadable; processed is regenerable)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# Exception: walk-forward baseline predictions are load-bearing for the
# v1.0-results freeze (SARIMAX is not bit-reproducible across BLAS builds)
!data/processed/baselines/
# Same rationale: validation-window predictions determine the ensemble
# weights, so they are load-bearing for the freeze too
!data/processed/validation_preds/
# Daily-direct walk-forward predictions (RQ4's direct arm)
!data/processed/daily_direct/
# The OOD live-data cache is NOT re-downloadable: the Energy-Charts API
# returns different data every day, so the exact window behind the reported
# OOD numbers exists only here. Committing it is what makes that result
# reproducible after the v1.0-results tag.
!data/raw/live_ood_de.csv
# OOD predictions + summary, derived from that cache
!data/processed/ood/

# Models & experiment artifacts
models/*
!models/.gitkeep
mlruns/

# Python
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Environments & editors
.env
.venv/
.vscode/
.DS_Store

# Graphify knowledge-graph output (regenerate with: graphify . --code-only)
graphify-out/

# Per-run stdout from long walk-forward jobs. Local diagnostic trail only —
# what a run concluded belongs in logs/decisions.md, which IS committed.
logs/runs/

# Claude Code: personal/session-local state (shared config in .claude/ is committed)
.claude/settings.local.json
.claude/worktrees/
